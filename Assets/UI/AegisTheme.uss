/* Aegis UI theme (design doc §7.9, §9.3): LoL-like palette — deep navy panels, gold frames,
   cream text, teal accents. Every view built in code adds this sheet and uses its classes. */

:root {
    --gold: #c8aa6e;
    --gold-light: #f0e6d2;
    --gold-dark: #785a28;
    --navy-0: #010a13;
    --navy-1: #0a1428;
    --navy-2: #091428;
    --navy-3: #1e2328;
    --teal: #0ac8b9;
    --text: #f0e6d2;
    --text-dim: #a09b8c;
    --red: #e84057;
    --green: #2ecc71;
    --blue: #3a8ee6;
    --prismatic: #c27cff;
}

.ae-root {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSans-Regular.ttf");
    color: var(--text);
    font-size: 13px;
}

/* ---- frames ---- */
.ae-panel {
    background-color: rgba(1, 10, 19, 0.92);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 4px;
    padding: 10px;
}
.ae-panel--glass {
    background-color: rgba(10, 20, 40, 0.78);
    border-color: rgba(200, 170, 110, 0.55);
}
.ae-frame-gold {
    border-width: 2px;
    border-top-color: var(--gold);
    border-left-color: var(--gold);
    border-right-color: var(--gold-dark);
    border-bottom-color: var(--gold-dark);
}
.ae-divider {
    height: 1px;
    background-color: rgba(200, 170, 110, 0.35);
    margin: 8px 0;
}

/* ---- text ---- */
.ae-title {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    color: var(--gold-light);
    font-size: 22px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
.ae-subtitle {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    color: var(--gold);
    font-size: 15px;
}
.ae-label { color: var(--text); font-size: 13px; }
.ae-dim { color: var(--text-dim); }
.ae-gold { color: #f5c542; -unity-font-style: bold; }
.ae-stat { color: var(--teal); }
.ae-bad { color: var(--red); }
.ae-outline { -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.9); }

/* ---- buttons ---- */
.ae-button {
    background-color: var(--navy-3);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 3px;
    color: var(--gold-light);
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    font-size: 14px;
    padding: 6px 18px;
    margin: 4px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}
.ae-button:hover {
    background-color: #2a3036;
    border-color: var(--gold);
    scale: 1.03 1.03;
}
.ae-button:active { background-color: #13181c; }
.ae-button:disabled { opacity: 0.45; }
.ae-button--primary {
    background-color: #1e4f5c;
    border-color: var(--teal);
}
.ae-button--primary:hover { background-color: #26697a; border-color: #5df5e8; }

/* ---- slots (abilities, items) ---- */
.ae-slot {
    background-color: rgba(1, 10, 19, 0.95);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 3px;
    overflow: hidden;
    transition-property: border-color, scale;
    transition-duration: 0.1s;
}
.ae-slot:hover { border-color: var(--gold); }
.ae-slot--selected { border-color: var(--teal); }
.ae-slot--prismatic { border-color: var(--prismatic); }
.ae-slot--locked { opacity: 0.4; }

/* ---- tooltips ---- */
.ae-tooltip {
    position: absolute;
    width: 300px;
    background-color: rgba(1, 10, 19, 0.97);
    border-width: 1px;
    border-color: var(--gold);
    border-radius: 3px;
    padding: 10px 12px;
}
.ae-tooltip__title {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    color: var(--gold-light);
    font-size: 15px;
}
.ae-tooltip__meta { color: var(--teal); font-size: 12px; margin-top: 2px; }
.ae-tooltip__text { color: var(--text); font-size: 12px; white-space: normal; margin-top: 6px; }

/* ---- tabs ---- */
.ae-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-color: transparent;
    color: var(--text-dim);
    font-size: 12px;
    padding: 2px 8px;
    margin: 0 2px;
}
.ae-tab:hover { color: var(--text); }
.ae-tab--active { color: var(--gold-light); border-bottom-color: var(--gold); }

/* ---- bars ---- */
.ae-bar {
    background-color: rgba(1, 10, 19, 0.95);
    border-width: 1px;
    border-color: #000000;
    border-radius: 2px;
    overflow: hidden;
}

/* ---- overlays and windows ---- */
.ae-overlay { background-color: rgba(0, 3, 8, 0.62); }
.ae-window {
    padding: 22px 26px;
    border-top-color: var(--gold);
    border-left-color: var(--gold);
    border-right-color: var(--gold-dark);
    border-bottom-color: var(--gold-dark);
}

/* ---- HUD layout ---- */
.ae-hud {
    position: absolute;
    left: 0; right: 0; bottom: 10px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}
.ae-hud__side {
    width: 204px;
    padding: 6px 8px 8px 8px;
    margin: 0 6px;
    background-color: rgba(1, 10, 19, 0.85);
}
.ae-hud__center { align-items: center; }
.ae-hud__main {
    flex-direction: row;
    align-items: flex-end;
    padding: 8px 12px 8px 8px;
    border-top-color: var(--gold);
}
.ae-hud__items { width: 168px; align-items: center; }

/* ---- portrait ---- */
.ae-portrait { width: 84px; height: 100px; align-items: center; }
.ae-portrait__image {
    width: 80px; height: 80px;
    border-radius: 40px;
    border-width: 3px;
    border-color: var(--gold);
    background-color: #0a1a2a;
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}
.ae-portrait__level {
    position: absolute;
    bottom: 2px;
    width: 30px; height: 26px;
    border-radius: 13px;
    border-width: 2px;
    border-color: var(--gold);
    background-color: var(--navy-0);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--gold-light);
}

/* ---- ability slots ---- */
.ae-slot--ability { border-color: var(--gold); }
.ae-slot--empty { opacity: 0.45; }
.ae-slot__locked { background-color: rgba(4, 6, 12, 0.72); }
.ae-slot__cooldown { background-color: rgba(0, 0, 0, 0.62); }
.ae-slot__key {
    position: absolute;
    left: 0; bottom: 0;
    padding: 0 3px;
    font-size: 11px;
    color: var(--gold-light);
    background-color: rgba(1, 10, 19, 0.85);
    border-top-right-radius: 3px;
}
.ae-plus {
    width: 18px; height: 18px;
    margin: 0 0 3px 0;
    padding: 0;
    border-width: 1px;
    border-color: #5a4210;
    border-radius: 9px;
    background-color: #f0c040;
    color: #1a1204;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.ae-plus:hover { background-color: #ffe080; scale: 1.15 1.15; }
.ae-pip {
    width: 7px; height: 4px;
    margin: 0 1px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
    border-radius: 1px;
    background-color: #2a2f38;
}
.ae-pip--on { background-color: #f0c040; }

/* ---- bars ---- */
.ae-bar { margin-top: 3px; width: 100%; }
.ae-bar--hp { height: 18px; }
.ae-bar--mana { height: 12px; }
.ae-bar--xp { height: 4px; border-width: 0; }
.ae-bar__fill { height: 100%; width: 100%; }
.ae-bar--hp .ae-bar__fill { background-color: #2fa84f; border-top-width: 2px; border-color: #6fe08a; }
.ae-bar--mana .ae-bar__fill { background-color: #2a6fd0; border-top-width: 1px; border-color: #7fb4ff; }
.ae-bar--xp .ae-bar__fill { background-color: #a070ff; }
.ae-bar__shield { position: absolute; top: 0; bottom: 0; background-color: rgba(235, 235, 245, 0.92); }
.ae-bar__text {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

/* ---- buffs, feedback ---- */
.ae-buffs { flex-direction: row; height: 30px; margin-bottom: 4px; }
.ae-buff {
    width: 28px; height: 28px;
    margin: 0 2px;
    border-width: 1px;
    border-color: var(--gold-dark);
    border-radius: 3px;
    background-color: rgba(1, 10, 19, 0.9);
    -unity-background-scale-mode: scale-to-fit;
}
.ae-buff--charged { border-color: #ffe070; border-width: 2px; }
.ae-buff__stacks {
    position: absolute;
    right: 1px; bottom: -2px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}
.ae-feedback {
    height: 20px;
    color: #ff8a70;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

/* ---- stats and augments panel ---- */
.ae-stat { flex-direction: row; align-items: center; width: 50%; height: 22px; }
.ae-stat__icon { width: 16px; height: 16px; margin-right: 5px; -unity-background-scale-mode: scale-to-fit; }
.ae-stat__value { font-size: 13px; color: var(--text); }
.ae-augment {
    width: 30px; height: 30px;
    margin: 2px;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(1, 10, 19, 0.9);
    -unity-background-scale-mode: scale-to-fit;
}
.ae-augment--silver { border-color: #c8d0dc; }
.ae-augment--gold { border-color: #ffcc4d; }
.ae-augment--prismatic { border-color: var(--prismatic); }

/* ---- items ---- */
.ae-items { flex-direction: row; flex-wrap: wrap; width: 150px; justify-content: center; }
.ae-item {
    width: 44px; height: 44px;
    margin: 2px;
    -unity-background-scale-mode: scale-to-fit;
}
.ae-elixir { font-size: 11px; color: #73e6b3; margin-top: 2px; }
.ae-gold {
    margin-top: 4px;
    font-size: 16px;
    -unity-font-style: bold;
    color: #f5c542;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}

/* ---- shop ---- */
.ae-shop { width: 940px; height: 600px; padding: 16px 18px; }
.ae-shop__header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.ae-shop__body { flex-direction: row; flex-grow: 1; }
.ae-shop__filters { width: 178px; margin-right: 10px; }
.ae-filter {
    background-color: transparent;
    border-width: 0;
    border-left-width: 3px;
    border-color: transparent;
    color: var(--text-dim);
    -unity-text-align: middle-left;
    font-size: 12px;
    padding: 5px 8px;
    white-space: nowrap;
    margin: 1px 0;
}
.ae-filter:hover { color: var(--text); background-color: rgba(200, 170, 110, 0.08); }
.ae-filter--active { color: var(--gold-light); border-left-color: var(--gold); background-color: rgba(200, 170, 110, 0.14); }
.ae-shop__grid { flex-grow: 1; }
.ae-shop__section { color: var(--gold); font-size: 12px; margin: 8px 0 4px 4px; -unity-font-style: bold; }
.ae-shop__row { flex-direction: row; flex-wrap: wrap; }
.ae-offer { width: 64px; align-items: center; margin: 3px; }
.ae-offer__icon {
    width: 52px; height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}
.ae-offer__price { font-size: 12px; color: #f5c542; -unity-font-style: bold; margin-top: 1px; }
.ae-offer--refused .ae-offer__icon { opacity: 0.4; }
.ae-offer--refused .ae-offer__price { color: #8c8577; }
.ae-offer--poor .ae-offer__price { color: var(--red); }
.ae-shop__detail {
    width: 280px;
    margin-left: 10px;
    padding: 12px;
    background-color: rgba(10, 20, 40, 0.75);
    border-width: 1px;
    border-color: var(--gold-dark);
    border-radius: 3px;
}
.ae-detail__head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.ae-detail__icon { width: 64px; height: 64px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.ae-detail__name { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 16px; color: var(--gold-light); white-space: normal; }
.ae-detail__stats { color: var(--teal); font-size: 13px; white-space: normal; margin-bottom: 6px; }
.ae-detail__text { color: var(--text); font-size: 12px; white-space: normal; }
.ae-detail__refusal { color: var(--red); font-size: 12px; margin-top: 6px; }
.ae-shop__footer { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; }
.ae-shop__inventory { flex-direction: row; }
.ae-shop__inventory .ae-item { width: 44px; height: 44px; }

/* ---- cards (anvils, augments) ---- */
.ae-card {
    width: 190px;
    margin: 6px;
    padding: 12px 10px 10px 10px;
    align-items: center;
    background-color: rgba(10, 20, 40, 0.92);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 4px;
    transition-property: translate, border-color;
    transition-duration: 0.12s;
}
.ae-card:hover { translate: 0 -4px; border-color: var(--gold); }
.ae-card__icon { width: 56px; height: 56px; margin-bottom: 6px; -unity-background-scale-mode: scale-to-fit; }
.ae-card__name { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 15px; white-space: normal; -unity-text-align: middle-center; }
.ae-card__body { font-size: 12px; color: var(--text); white-space: normal; -unity-text-align: middle-center; margin-top: 4px; flex-grow: 1; }
.ae-card__note { font-size: 11px; color: #ff8a70; margin-top: 3px; }

/* ---- top run HUD and boss bar ---- */
.ae-runhud {
    padding: 6px 18px;
    background-color: rgba(1, 10, 19, 0.85);
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}
.ae-bossbar { border-width: 2px; border-color: var(--gold-dark); background-color: rgba(30, 6, 10, 0.9); }

/* ---- polish: ready flash, menus ---- */
.ae-slot--ready { border-color: #fff0b0; scale: 1.08 1.08; }
.ae-slot--ability { transition-property: border-color, scale; transition-duration: 0.18s; }
.ae-banner {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    font-size: 34px;
    color: #f0e6d2;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(120, 90, 40, 0.9);
    margin-top: 18px;
    opacity: 0;
    scale: 0.85 0.85;
    transition-property: opacity, scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}
.ae-banner--show { opacity: 1; scale: 1 1; }

/* ---- augment draft, Arena style ---- */
.ae-draft { background-color: transparent; border-width: 0; width: 960px; }
.ae-card--augment { width: 290px; min-height: 400px; margin: 10px; padding: 22px 16px 14px 16px; border-width: 3px; border-radius: 8px; flex-shrink: 0; }
.ae-card--augment .ae-card__icon { width: 112px; height: 112px; margin-bottom: 14px; }
.ae-card--augment .ae-card__name { font-size: 21px; }
.ae-card--augment .ae-card__body { font-size: 14px; margin-top: 12px; }
.ae-card--silver { background-color: rgba(40, 46, 60, 0.95); border-color: #c8d0dc; }
.ae-card--gold { background-color: rgba(60, 46, 16, 0.95); border-color: #ffcc4d; }
.ae-card--prismatic { background-color: rgba(48, 22, 70, 0.95); border-color: #d08cff; }
.ae-card--augment:hover { translate: 0 -8px; scale: 1.03 1.03; }

/* ---- meta progression ---- */
.ae-meta { width: 1080px; padding: 18px 22px; background-color: rgb(8, 14, 28); }
.ae-meta__tree { margin: 16px auto 14px auto; align-self: center; }
.ae-meta__node {
    padding: 8px 10px;
    background-color: rgba(10, 20, 40, 0.95);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 5px;
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}
.ae-meta__node:hover { border-color: var(--gold); translate: 0 -2px; }
.ae-meta__node--owned { border-color: var(--gold); background-color: rgba(40, 32, 12, 0.95); }
.ae-meta__node--max { border-color: #ffe080; }
.ae-meta__node--locked { opacity: 0.5; }
.ae-meta__icon { width: 40px; height: 40px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.ae-meta__name { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 14px; color: var(--gold-light); white-space: normal; }
.ae-reward { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 20px; color: #c8a0ff; margin-bottom: 10px; -unity-text-align: middle-center; }
