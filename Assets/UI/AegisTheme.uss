/* Aegis UI theme (design doc §7.9, §9.3): cold aurora palette — night-blue panels, violet
   frames, ice text, cyan and violet glows. Every view built in code adds this sheet and uses its classes. */

:root {
    /* aurora: night-blue panels, violet frames, ice text, cyan glow (the old names are kept) */
    --gold: #8f80ff;
    --gold-light: #e2e8ff;
    --gold-dark: #3d3b86;
    --navy-0: #04051a;
    --navy-1: #0a0d2e;
    --navy-2: #0b1032;
    --navy-3: #171b46;
    --teal: #5ce1ff;
    --text: #e2e8ff;
    --text-dim: #8e97c6;
    --red: #ff5a7a;
    --green: #3fe0a0;
    --blue: #5b8cff;
    --prismatic: #d08cff;
    --aurora-cyan: #5ce1ff;
    --aurora-violet: #a77bff;
}

.ae-root {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSans-Regular.ttf");
    color: var(--text);
    font-size: 13px;
}

/* ---- frames ---- */
.ae-panel {
    background-color: rgba(6, 8, 30, 0.92);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 4px;
    padding: 10px;
}
.ae-panel--glass {
    background-color: rgba(14, 16, 48, 0.78);
    border-color: rgba(150, 130, 255, 0.55);
}
.ae-frame-gold {
    border-width: 2px;
    border-top-color: var(--gold);
    border-left-color: var(--gold);
    border-right-color: var(--gold-dark);
    border-bottom-color: var(--gold-dark);
}
.ae-divider {
    height: 1px;
    background-color: rgba(150, 130, 255, 0.35);
    margin: 8px 0;
}

/* ---- text ---- */
.ae-title {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    color: var(--gold-light);
    font-size: 22px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
.ae-subtitle {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    color: var(--gold);
    font-size: 15px;
}
.ae-label { color: var(--text); font-size: 13px; }
.ae-dim { color: var(--text-dim); }
.ae-gold { color: #f5c542; -unity-font-style: bold; }
.ae-stat { color: var(--teal); }
.ae-bad { color: var(--red); }
.ae-outline { -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.9); }

/* ---- buttons ---- */
.ae-button {
    background-color: var(--navy-3);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 3px;
    color: var(--gold-light);
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    font-size: 14px;
    padding: 6px 18px;
    margin: 4px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}
.ae-button:hover {
    background-color: #262b66;
    border-color: var(--gold);
    scale: 1.03 1.03;
}
.ae-button:active { background-color: #0c0f2a; }
.ae-button:disabled { opacity: 0.45; }
.ae-button--primary {
    background-color: #1b3a7a;
    border-color: var(--teal);
}
.ae-button--primary:hover { background-color: #2752a6; border-color: #a8f2ff; }
.ae-button--golden { background-color: #5a4310; border-color: #ffd65c; color: #fff2c4; }
.ae-button--golden:hover { background-color: #7a5c18; border-color: #fff0a0; }

/* ---- slots (abilities, items) ---- */
.ae-slot {
    background-color: rgba(6, 8, 30, 0.95);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 3px;
    overflow: hidden;
    transition-property: border-color, scale;
    transition-duration: 0.1s;
}
.ae-slot:hover { border-color: var(--gold); }
.ae-slot--selected { border-color: var(--teal); }
.ae-slot--prismatic { border-color: var(--prismatic); }
.ae-slot--locked { opacity: 0.4; }

/* ---- tooltips ---- */
.ae-tooltip {
    position: absolute;
    width: 300px;
    background-color: rgba(6, 8, 30, 0.97);
    border-width: 1px;
    border-color: var(--gold);
    border-radius: 3px;
    padding: 10px 12px;
}
.ae-tooltip__title {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    color: var(--gold-light);
    font-size: 15px;
}
.ae-tooltip__meta { color: var(--teal); font-size: 12px; margin-top: 2px; }
.ae-tooltip__text { color: var(--text); font-size: 12px; white-space: normal; margin-top: 6px; }

/* ---- tabs ---- */
.ae-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-color: transparent;
    color: var(--text-dim);
    font-size: 12px;
    padding: 2px 8px;
    margin: 0 2px;
}
.ae-tab:hover { color: var(--text); }
.ae-tab--active { color: var(--gold-light); border-bottom-color: var(--gold); }

/* ---- bars ---- */
.ae-bar {
    background-color: rgba(6, 8, 30, 0.95);
    border-width: 1px;
    border-color: #000000;
    border-radius: 2px;
    overflow: hidden;
}

/* ---- overlays and windows ---- */
.ae-overlay { background-color: rgba(2, 2, 14, 0.62); }
.ae-window {
    padding: 22px 26px;
    background-image: url("project://database/Assets/UI/Textures/Aurora.png");
    background-size: cover; background-position-y: top; background-position-x: center;
    border-top-color: var(--gold);
    border-left-color: var(--gold);
    border-right-color: var(--gold-dark);
    border-bottom-color: var(--gold-dark);
}

/* ---- HUD layout: one dock along the bottom edge, MOBA style ---- */
.ae-hud {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}
.ae-dock-panel {
    background-image: url("project://database/Assets/UI/Textures/Panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(4, 10, 20, 0.0);
    border-width: 2px;
    border-bottom-width: 0;
    border-top-color: var(--gold);
    border-left-color: var(--gold-dark);
    border-right-color: var(--gold-dark);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
.ae-hud__side {
    width: 212px;
    height: 150px;
    padding: 6px 10px 6px 10px;
    margin: 0;
}
.ae-hud__side--left { border-right-width: 0; border-top-right-radius: 0; }
.ae-hud__side--right { border-left-width: 0; border-top-left-radius: 0; }
.ae-hud__center { align-items: center; }
.ae-hud__main {
    flex-direction: row;
    align-items: flex-end;
    padding: 10px 14px 10px 12px;
    border-top-width: 3px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
.ae-hud__items { align-items: center; justify-content: flex-start; }
.ae-hud__ornament {
    position: absolute;
    top: -8px; left: 20%; right: 20%;
    height: 12px;
    background-image: url("project://database/Assets/UI/Textures/Divider.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---- portrait ---- */
.ae-portrait { width: 84px; height: 100px; align-items: center; }
.ae-portrait__image {
    width: 80px; height: 80px;
    border-radius: 40px;
    border-width: 3px;
    border-color: var(--gold);
    background-color: #0b1036;
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}
.ae-portrait__level {
    position: absolute;
    bottom: 2px;
    width: 30px; height: 26px;
    border-radius: 13px;
    border-width: 2px;
    border-color: var(--gold);
    background-color: var(--navy-0);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--gold-light);
}

/* ---- ability slots ---- */
.ae-slot--ability { border-color: var(--gold); }
.ae-slot--empty { opacity: 0.45; }
.ae-slot__locked { background-color: rgba(4, 5, 20, 0.72); }
.ae-slot__cooldown { background-color: rgba(0, 0, 0, 0.62); }
.ae-slot__key {
    position: absolute;
    left: 0; bottom: 0;
    padding: 0 3px;
    font-size: 11px;
    color: var(--gold-light);
    background-color: rgba(6, 8, 30, 0.85);
    border-top-right-radius: 3px;
}
.ae-plus {
    width: 18px; height: 18px;
    margin: 0 0 3px 0;
    padding: 0;
    border-width: 1px;
    border-color: #3d3b86;
    border-radius: 9px;
    background-color: #f0c040;
    color: #1a1204;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.ae-plus:hover { background-color: #ffe080; scale: 1.15 1.15; }
.ae-pip {
    width: 7px; height: 4px;
    margin: 0 1px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
    border-radius: 1px;
    background-color: #262a55;
}
.ae-pip--on { background-color: #f0c040; }

/* ---- bars ---- */
.ae-bar { margin-top: 3px; width: 100%; }
.ae-bar--hp { height: 20px; border-color: #000000; background-color: #0d0a1a; }
.ae-bar--mana { height: 14px; background-color: #090c22; }
.ae-bar--xp { height: 5px; border-width: 0; background-color: #0c0920; }
.ae-bar__fill { height: 100%; width: 100%; transition-property: width; transition-duration: 0.15s; }
.ae-bar--hp .ae-bar__fill { background-color: #1f9a43; }
.ae-bar--mana .ae-bar__fill { background-color: #1d63c8; }
.ae-bar--xp .ae-bar__fill { background-color: #9b6bff; }
.ae-bar__gloss {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project://database/Assets/UI/Textures/Gloss.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.ae-bar__ticks { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.ae-bar__shield { position: absolute; top: 0; bottom: 0; background-color: rgba(235, 235, 245, 0.92); }
.ae-bar__text {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(0, 0, 0, 1);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

/* ---- buffs, feedback ---- */
.ae-buffs { flex-direction: row; height: 30px; margin-bottom: 4px; }
.ae-buff {
    width: 28px; height: 28px;
    margin: 0 2px;
    border-width: 1px;
    border-color: var(--gold-dark);
    border-radius: 3px;
    background-color: rgba(6, 8, 30, 0.9);
    -unity-background-scale-mode: scale-to-fit;
}
.ae-buff--charged { border-color: #ffe070; border-width: 2px; }
.ae-buff__stacks {
    position: absolute;
    right: 1px; bottom: -2px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}
.ae-feedback {
    height: 20px;
    color: #ff8a70;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

/* ---- stats and augments panel ---- */
.ae-stat { flex-direction: row; align-items: center; width: 50%; height: 19px; }
.ae-stat__icon { width: 16px; height: 16px; margin-right: 5px; -unity-background-scale-mode: scale-to-fit; }
.ae-stat__value { font-size: 13px; color: var(--text); }
.ae-augment {
    width: 30px; height: 30px;
    margin: 2px;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(6, 8, 30, 0.9);
    -unity-background-scale-mode: scale-to-fit;
}
.ae-augment--silver { border-color: #c8d0dc; }
.ae-augment--gold { border-color: #ffcc4d; }
.ae-augment--prismatic { border-color: var(--prismatic); }

/* ---- items ---- */
.ae-items { flex-direction: row; flex-wrap: wrap; width: 156px; justify-content: center; }
.ae-item {
    width: 46px; height: 46px;
    margin: 2px;
    -unity-background-scale-mode: scale-to-fit;
    border-color: #2e2c6a;
    background-color: rgba(4, 5, 22, 0.9);
}
.ae-elixir { font-size: 11px; color: #73e6b3; margin-top: 2px; }
.ae-goldrow { flex-direction: row; align-items: center; margin-top: 4px; }
.ae-coin { width: 18px; height: 18px; margin-right: 5px; background-image: url("project://database/Assets/UI/Textures/Coin.png"); -unity-background-scale-mode: scale-to-fit; }
.ae-gold {
    font-size: 16px;
    -unity-font-style: bold;
    color: #f5c542;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}

/* ---- shop ---- */
.ae-shop-overlay { background-color: rgba(2, 2, 14, 0.45); }
.ae-shop {
    width: 1230px; height: 760px; padding: 0;
    background-image: url("project://database/Assets/UI/Textures/Aurora.png");
    background-size: cover; background-position-y: top; background-position-x: center;
    border-width: 2px; border-color: var(--gold-dark); border-top-color: var(--gold);
    border-radius: 6px; overflow: hidden;
}
.ae-shop__header {
    flex-direction: row; align-items: center; height: 54px; padding: 0 14px;
    background-color: rgba(6, 8, 30, 0.85);
    border-bottom-width: 1px; border-bottom-color: rgba(150, 130, 255, 0.4);
}
.ae-shop__title { font-size: 20px; margin: 0 18px 0 0; -unity-text-align: middle-left; }
.ae-shop__search { width: 260px; margin: 0; }
.ae-shop__search > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.55); border-color: var(--gold-dark); border-radius: 3px;
    color: var(--text); padding: 4px 8px; font-size: 13px; min-height: 28px;
}
.ae-shop__search > .unity-text-field__input:focus { border-color: var(--gold); }
.ae-shop__close { width: 34px; height: 34px; padding: 0; margin-left: 14px; font-size: 16px; }
.ae-shop__body { flex-direction: row; flex-grow: 1; flex-shrink: 1; padding: 10px 12px 0 12px; }
/* left edge: vertical tabs, their panels slide out to the left of the window */
.ae-shop-frame { position: relative; }
.ae-shop__side { position: absolute; right: 100%; top: 70px; flex-direction: row-reverse; align-items: flex-start; }
.ae-shop__tabs { width: 36px; }
.ae-sidetab {
    width: 36px; height: 150px; margin-bottom: 6px;
    background-image: url("project://database/Assets/UI/Textures/Panel.png");
    border-width: 2px; border-right-width: 0; border-color: var(--gold-dark); border-left-color: var(--gold);
    border-top-left-radius: 6px; border-bottom-left-radius: 6px;
    transition-property: border-color, translate, background-color; transition-duration: 0.15s;
}
.ae-sidetab:hover, .ae-sidetab--open { border-color: var(--gold); border-left-color: var(--aurora-cyan); translate: -3px 0; background-color: rgba(30, 32, 86, 0.6); }
.ae-sidetab__label {
    position: absolute; width: 150px; height: 36px; left: -57px; top: 57px; rotate: -90deg;
    -unity-text-align: middle-center; font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; color: var(--text-dim);
}
.ae-sidetab:hover .ae-sidetab__label, .ae-sidetab--open .ae-sidetab__label { color: var(--gold-light); }
.ae-shop__flyouts { width: 252px; position: relative; }
.ae-drawer {
    position: absolute; right: 2px; width: 248px;
    background-image: url("project://database/Assets/UI/Textures/Aurora.png");
    background-size: cover; background-position-y: top; background-position-x: center;
    border-width: 2px; border-color: var(--gold-dark); border-top-color: var(--gold); border-left-color: var(--aurora-cyan);
    border-top-left-radius: 6px; border-bottom-left-radius: 6px;
    opacity: 0; translate: 40px 0;
    transition-property: opacity, translate; transition-duration: 0.18s; transition-timing-function: ease-out-cubic;
}
.ae-drawer--open { opacity: 1; translate: 0 0; }
.ae-drawer__head {
    margin: 0; padding: 0 12px; height: 34px;
    color: var(--gold-light); font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; -unity-text-align: middle-left;
    background-color: rgba(92, 225, 255, 0.10);
    border-bottom-width: 1px; border-bottom-color: rgba(150, 130, 255, 0.35);
}
.ae-drawer__body { flex-direction: row; flex-wrap: wrap; padding: 6px 6px 8px 6px; }
.ae-shop__owned { width: 50px; height: 50px; margin: 3px 3px; }
.ae-shop__owned.ae-slot--selected { border-color: var(--gold-light); }
/* center: the base panel */
.ae-shop__main {
    flex-grow: 1; flex-shrink: 1;
    background-color: rgba(6, 8, 30, 0.55);
    border-width: 1px; border-color: var(--gold-dark); border-radius: 3px;
}
.ae-shop__categories {
    flex-direction: row; justify-content: center; padding: 6px 8px; flex-shrink: 0;
    border-bottom-width: 1px; border-bottom-color: rgba(150, 130, 255, 0.3);
    background-color: rgba(6, 8, 30, 0.6);
}
.ae-shop__categories .ae-iconbutton { width: 44px; height: 44px; margin: 0 5px; }
.ae-shop__main-row { flex-direction: row; flex-grow: 1; flex-shrink: 1; }
.ae-shop__stats {
    width: 46px; flex-shrink: 0; align-items: center; padding-top: 6px;
    border-right-width: 1px; border-right-color: rgba(150, 130, 255, 0.3);
    background-color: rgba(6, 8, 30, 0.6);
}
.ae-shop__stats .ae-iconbutton { width: 34px; height: 34px; margin: 2px 0; }
.ae-iconbutton {
    padding: 5px; border-width: 1px; border-color: transparent; border-radius: 4px;
    background-color: transparent; align-items: center; justify-content: center;
    transition-property: border-color, background-color; transition-duration: 0.1s;
}
.ae-iconbutton:hover { background-color: rgba(150, 130, 255, 0.12); border-color: var(--gold-dark); }
.ae-iconbutton--active { background-color: rgba(150, 130, 255, 0.22); border-color: var(--gold); }
.ae-iconbutton__icon { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; opacity: 0.7; }
.ae-iconbutton:hover .ae-iconbutton__icon { opacity: 0.95; }
.ae-iconbutton--active .ae-iconbutton__icon { opacity: 1; }
.ae-shop__grid { flex-grow: 1; flex-shrink: 1; padding: 0 6px 6px 10px; }
.ae-shop__anvils { padding-bottom: 4px; }
.ae-shop__section {
    color: var(--gold-light); font-size: 12px; margin: 10px 0 6px 2px; -unity-font-style: bold; letter-spacing: 1px;
    padding-bottom: 3px; border-bottom-width: 1px; border-bottom-color: rgba(150, 130, 255, 0.25);
}
.ae-shop__row { flex-direction: row; flex-wrap: wrap; }
.ae-offer { width: 62px; align-items: center; margin: 3px 2px; }
.ae-offer__icon { width: 50px; height: 50px; -unity-background-scale-mode: scale-to-fit; transition-property: scale, border-color; transition-duration: 0.1s; }
.ae-offer:hover .ae-offer__icon { scale: 1.07 1.07; border-color: var(--gold); }
.ae-offer__price { font-size: 12px; color: #f5c542; -unity-font-style: bold; margin-top: 2px; }
.ae-offer--refused .ae-offer__icon { opacity: 0.38; }
.ae-offer--refused .ae-offer__price { color: #6f78a8; }
.ae-offer--poor .ae-offer__price { color: var(--red); }
.ae-offer--owned .ae-offer__icon { border-color: var(--teal); }
.ae-shop__detail {
    width: 300px; flex-shrink: 0; margin-left: 10px; margin-bottom: 2px; padding: 14px;
    background-color: rgba(6, 8, 30, 0.75);
    border-width: 1px; border-color: var(--gold-dark); border-radius: 3px;
}
.ae-detail__head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.ae-detail__icon { width: 64px; height: 64px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.ae-detail__name { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 17px; color: var(--gold-light); white-space: normal; }
.ae-detail__tags { color: var(--text-dim); font-size: 11px; margin-bottom: 6px; white-space: normal; }
.ae-detail__stats { color: var(--teal); font-size: 13px; white-space: normal; margin-bottom: 8px; }
.ae-detail__text { color: var(--text); font-size: 12px; white-space: normal; }
.ae-detail__refusal { color: var(--red); font-size: 12px; margin: 6px 0 4px 0; white-space: normal; }
.ae-button--sell { background-color: #5c1e1e; border-color: #c25050; }
.ae-button--sell:hover { background-color: #7a2828; border-color: #ff8080; }
.ae-shop__footer {
    flex-direction: row; align-items: center; height: 58px; padding: 0 14px; margin-top: 8px; flex-shrink: 0;
    background-color: rgba(6, 8, 30, 0.85);
    border-top-width: 1px; border-top-color: rgba(150, 130, 255, 0.4);
}
.ae-shop__header { flex-shrink: 0; }
.ae-shop__status { flex-grow: 1; color: var(--text); font-size: 13px; -unity-text-align: middle-left; white-space: normal; }
.ae-shop__status--closed { color: #ff9a80; }
.ae-shop__hint { color: var(--text-dim); font-size: 11px; margin-right: 16px; -unity-text-align: middle-right; }
.ae-shop__start { width: 200px; height: 40px; font-size: 15px; }
.ae-hud__shop { margin-left: 10px; padding: 1px 8px; font-size: 11px; height: 20px; background-color: var(--navy-3); border-width: 1px; border-color: var(--gold-dark); border-radius: 3px; color: var(--gold-light); }
.ae-hud__shop:hover { border-color: var(--gold); }
.ae-runhud__break { flex-direction: row; justify-content: center; margin-top: 6px; }
.ae-runhud__start { height: 32px; font-size: 14px; padding: 0 16px; }
.ae-runhud__shop { height: 32px; font-size: 13px; padding: 0 12px; }

/* ---- cards (anvils, augments) ---- */
.ae-card {
    width: 190px;
    margin: 6px;
    padding: 12px 10px 10px 10px;
    align-items: center;
    background-color: rgba(14, 16, 48, 0.92);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 4px;
    transition-property: translate, border-color;
    transition-duration: 0.12s;
}
.ae-card--clickable:hover { translate: 0 -4px; border-color: var(--gold); background-color: rgba(30, 32, 86, 0.95); }
.ae-card--clickable:active { scale: 0.98 0.98; }
.ae-card--disabled { opacity: 0.5; }
.ae-card-column { align-items: stretch; margin: 0 6px; }
.ae-card-column > .ae-card { margin: 6px 0; flex-grow: 1; }
.ae-card-column__button { margin: 2px 0 0 0; }
.ae-card__icon { width: 56px; height: 56px; margin-bottom: 6px; -unity-background-scale-mode: scale-to-fit; }
.ae-card__name { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 15px; white-space: normal; -unity-text-align: middle-center; }
.ae-card__body { font-size: 12px; color: var(--text); white-space: normal; -unity-text-align: middle-center; margin-top: 4px; flex-grow: 1; }
.ae-card__note { font-size: 11px; color: #ff8a70; margin-top: 3px; }

/* ---- top run HUD and boss bar ---- */
.ae-runhud {
    padding: 6px 22px 8px 22px;
    background-image: url("project://database/Assets/UI/Textures/Panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: var(--gold);
    border-left-color: var(--gold-dark);
    border-right-color: var(--gold-dark);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
.ae-bossbar { border-width: 2px; border-color: var(--gold-dark); background-color: rgba(30, 6, 10, 0.9); }

/* ---- polish: ready flash, menus ---- */
.ae-slot--ready { border-color: #fff0b0; scale: 1.08 1.08; }
.ae-slot--ability { transition-property: border-color, scale; transition-duration: 0.18s; }
.ae-banner {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    font-size: 34px;
    color: #e2e8ff;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(70, 60, 170, 0.9);
    margin-top: 18px;
    opacity: 0;
    scale: 0.85 0.85;
    transition-property: opacity, scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}
.ae-banner--show { opacity: 1; scale: 1 1; }

/* ---- augment draft, arena-draft style ---- */
.ae-draft { background-color: transparent; background-image: none; border-width: 0; width: 960px; }
.ae-card--augment { width: 290px; min-height: 400px; margin: 10px 0; padding: 22px 16px 14px 16px; border-width: 3px; border-radius: 8px; flex-shrink: 0; }
.ae-card--augment .ae-card__icon { width: 112px; height: 112px; margin-bottom: 14px; }
.ae-card--augment .ae-card__name { font-size: 21px; }
.ae-card--augment .ae-card__body { font-size: 14px; margin-top: 12px; }
.ae-card--silver { background-color: rgba(40, 46, 60, 0.95); border-color: #c8d0dc; }
.ae-card--gold { background-color: rgba(60, 46, 16, 0.95); border-color: #ffcc4d; }
.ae-card--prismatic { background-color: rgba(48, 22, 70, 0.95); border-color: #d08cff; }
.ae-card--augment.ae-card--clickable:hover { translate: 0 -8px; scale: 1.03 1.03; }
.ae-card--silver.ae-card--clickable:hover { background-color: rgba(54, 62, 80, 0.97); border-color: #ffffff; }
.ae-card--gold.ae-card--clickable:hover { background-color: rgba(80, 62, 22, 0.97); border-color: #ffe08a; }
.ae-card--prismatic.ae-card--clickable:hover { background-color: rgba(64, 30, 94, 0.97); border-color: #ecc4ff; }
.ae-draft .ae-card-column { margin: 0 10px; }

/* ---- meta progression ---- */
.ae-meta { width: 1080px; padding: 18px 22px; background-color: rgb(8, 14, 28); }
.ae-meta__tree { margin: 16px auto 14px auto; align-self: center; }
.ae-meta__node {
    padding: 8px 10px;
    background-color: rgba(14, 16, 48, 0.95);
    border-width: 2px;
    border-color: var(--gold-dark);
    border-radius: 5px;
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}
.ae-meta__node:hover { border-color: var(--gold); translate: 0 -2px; }
.ae-meta__node--owned { border-color: var(--gold); background-color: rgba(34, 26, 78, 0.95); }
.ae-meta__node--max { border-color: #ffe080; }
.ae-meta__node--locked { opacity: 0.5; }
.ae-meta__icon { width: 40px; height: 40px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.ae-meta__name { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 14px; color: var(--gold-light); white-space: normal; }
.ae-reward { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 20px; color: #c8a0ff; margin-bottom: 10px; -unity-text-align: middle-center; }

/* ---- scrollbars: thin aurora rail, glowing thumb, no arrows ---- */
.ae-root .unity-scroller--vertical { width: 10px; margin-left: 2px; }
.ae-root .unity-scroller--horizontal { height: 10px; }
.ae-root .unity-scroller .unity-repeat-button { display: none; }
.ae-root .unity-scroller .unity-slider { margin: 2px 0; flex-grow: 1; }
.ae-root .unity-scroller .unity-base-slider__tracker {
    background-image: url("project://database/Assets/UI/Textures/ScrollTrack.png");
    -unity-slice-top: 6; -unity-slice-bottom: 6; -unity-slice-left: 4; -unity-slice-right: 4;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; left: 2px; right: 2px; width: auto;
}
.ae-root .unity-scroller .unity-base-slider__dragger {
    background-image: url("project://database/Assets/UI/Textures/ScrollThumb.png");
    -unity-slice-top: 8; -unity-slice-bottom: 8; -unity-slice-left: 4; -unity-slice-right: 4;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; left: 1px; right: 1px; width: auto; min-height: 28px;
}
.ae-root .unity-scroller .unity-base-slider__dragger:hover { -unity-background-image-tint-color: #d6f6ff; }
.ae-root .unity-scroller .unity-base-slider__dragger-border { display: none; }

/* ---- champion select ---- */
.ae-champselect { width: 1060px; padding: 22px 26px 18px 26px; }
.ae-champselect__cards { flex-direction: row; justify-content: center; margin: 14px 0 16px 0; }
.ae-champ {
    width: 440px; margin: 0 14px; padding: 16px 18px 14px 18px; align-items: center;
    background-color: rgba(10, 12, 40, 0.85);
    border-width: 2px; border-color: var(--gold-dark); border-radius: 8px;
    transition-property: border-color, translate, background-color; transition-duration: 0.15s;
}
.ae-champ:hover { border-color: var(--gold); translate: 0 -4px; }
.ae-champ--selected { border-color: var(--aurora-cyan); background-color: rgba(24, 28, 84, 0.92); }
.ae-champ__portrait {
    width: 220px; height: 220px; border-radius: 110px; border-width: 3px; border-color: var(--gold-dark);
    background-color: rgba(30, 32, 86, 0.8); -unity-background-scale-mode: scale-and-crop;
}
.ae-champ--selected .ae-champ__portrait { border-color: var(--aurora-cyan); }
.ae-champ__name { -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf"); font-size: 26px; color: var(--gold-light); margin-top: 10px; }
.ae-champ__epithet { font-size: 14px; color: var(--aurora-violet); -unity-font-style: italic; margin-bottom: 8px; }
.ae-champ__summary { font-size: 13px; color: var(--text); white-space: normal; -unity-text-align: middle-center; min-height: 72px; }
.ae-champ__kit { flex-direction: row; justify-content: center; margin-top: 10px; }
.ae-champ__spell { width: 54px; height: 54px; margin: 0 4px; -unity-background-scale-mode: scale-to-fit; }
.ae-champ__key {
    position: absolute; bottom: 0; right: 2px; font-size: 11px; -unity-font-style: bold; color: var(--gold-light);
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}
.ae-champselect__footer { flex-direction: row; align-items: center; }
.ae-champselect__play { width: 240px; height: 46px; font-size: 18px; }
.ae-meta__tabs { flex-direction: row; justify-content: center; margin: 6px 0 2px 0; }
.ae-meta__tabs .ae-tab { font-size: 15px; padding: 4px 18px 8px 18px; margin: 0 6px; }
