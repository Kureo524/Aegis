VisualElement {
}

.menu {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(20, 20, 30);   /* opaque : cache la scène Game */

    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}
.menu--revealed { translate: 0 -100%; }   /* menu sorti par le haut */

.button {
    opacity: 1;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    align-items: center;
    justify-content: space-between;
    align-self: center;
    align-content: center;
    width: 320px;
    height: 50px;
    aspect-ratio: auto;
    font-size: 30px;
}
