VisualElement {
}

.menu {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(6, 10, 26);   /* opaque : cache la scène Game */
    background-image: url("project://database/Assets/GraphicAssets/Sprites/UI/MenuBackground.png");
    -unity-background-scale-mode: scale-and-crop;

    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}
.menu--revealed { translate: 0 -100%; }   /* menu sorti par le haut */

.button {
    opacity: 1;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    align-items: center;
    justify-content: space-between;
    align-self: center;
    align-content: center;
    width: 300px;
    height: 52px;
    aspect-ratio: auto;
    font-size: 22px;
}

.menu-title {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    font-size: 96px;
    color: #f0e6d2;
    letter-spacing: 18px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #785a28;
    margin-bottom: 0;
}
.menu-subtitle {
    -unity-font: url("project://database/Assets/UI/Fonts/NotoSerif-Bold.ttf");
    font-size: 26px;
    color: #c8aa6e;
    letter-spacing: 8px;
    margin-bottom: 40px;
}
